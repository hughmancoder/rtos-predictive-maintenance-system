{
  "name": "FreeRTOS-Kernel",
  "version": "11.3.1",
  "description": "FreeRTOS Kernel V11.3.1 (ARM_CM4F port, heap_4)",
  "build": {
    "includeDir": "include",
    "flags": [
      "-Iportable/GCC/ARM_CM4F",
      "-I../../include"
